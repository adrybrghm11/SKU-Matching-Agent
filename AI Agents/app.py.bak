                    sku_lookup,
                    inventory_by_sku,
                    part_list_map,
                    part_list_lookup,
                )
                st.text_area("Copy/paste this reply", value=draft, height=420)

with tab2:
    query = st.text_input(
        "Describe the product you need",
        placeholder="Surface Laptop 15 Ultra 7 16/512 Platinum"
    )
    if st.button("Search products"):
        results = search_products_by_description(query, sku_lookup, inventory_by_sku)
        if results:
            st.table(results)
        else:
            st.info("No matching products found.")
